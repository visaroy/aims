#!/usr/bin/env bash
set -euo pipefail
# Portable resolve of the install root (BSD/macOS + GNU/Linux, follows symlinks).
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"; SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
AIMS_ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
export AIMS_ROOT
cmd="${1:-help}"; [ $# -gt 0 ] && shift || true
case "$cmd" in
  start|save|handoff|handoff-all|checkpoint|adopt|publish|list|brief|rebase|status|continue|conflicts) exec "$AIMS_ROOT/lib/aims-$cmd" "$@" ;;
  init)      exec "$AIMS_ROOT/lib/aims-init" "$@" ;;
  artifacts) exec "$AIMS_ROOT/lib/aims-artifacts" "$@" ;;
  wire-agents) exec "$AIMS_ROOT/lib/aims-wire-agents" "$@" ;;
  install-hooks) exec "$AIMS_ROOT/lib/aims-install-hooks" "$@" ;;
  doctor)    exec "$AIMS_ROOT/lib/aims-doctor" "$@" ;;
  preflight) exec "$AIMS_ROOT/lib/session-preflight" "$@" ;;
  version|-v|--version)
    [ "$#" -eq 0 ] || { echo "usage: aims version" >&2; exit 2; }
    grep -m1 . "$AIMS_ROOT/VERSION" 2>/dev/null || echo "AIMS (dev)" ;;
  help|-h|--help|"")
    [ "$#" -eq 0 ] || { echo "usage: aims help" >&2; exit 2; }
    cat <<'USAGE'
AIMS — AI Multi-agent Sessions
Git-native session management for AI agents across machines.

usage: aims <command> [args]

  init [dir]            Scaffold a data repo (default: $AIMS_HOME or ~/.aims)
  start <proj> <topic> [agent] [--scope ...] [--continues-from <id>] [--parent-session <id>]
                        Start a session (branch + worktree)
  save                  Checkpoint: commit whole worktree + push (run in worktree)
  handoff [note]        Hand session from its worktree (push all + mark)
  handoff check <session-id>  Check handoff readiness without changing session state
  handoff <session-id>  Hand one local session from AIMS_HOME/.worktrees
  handoff-all [--yes]   Hand off all valid local AIMS worktrees from AIMS_HOME
  checkpoint <session-id> Save and push one local session without handoff
  brief <session-id>    Create an optional concise handoff brief
  rebase <session-id|ai/session-id>  Rebase a clean session onto origin/main
  adopt <session-id> [--remote]   Take over an active session from origin
  status <session-id>             Resolve active, published, or unknown session state
  continue <published-id> <topic> [agent] [--scope ...]
                        Start a new session from current main with recorded lineage
  conflicts --scope <csv> [--session <id>]
                        Explain writable-scope overlaps with active remote sessions
  publish <session-id>  Merge session to main, retain artifacts, delete branch
  list [--handoff] [--stale] [--closed] [--project <project>]
                        List active remote sessions or published session records
  artifacts <id>        Print/create the session dir in the shared store (AIMS_ARTIFACTS)
  doctor                Health-check the install and data repo
  wire-agents           Teach installed agents to understand AIMS (writes their rule files)
  install-hooks         (Re)install the pre-push guard into the data repo (init does this too)
  preflight [mode]      Report whether the current Git repo can start an AIMS session
  version | -v | --version       Print version
  help | -h | --help             Print this help

Docs: docs/AIMS.md · docs/ARCHITECTURE.md · docs/COMMANDS.md
Env:  AIMS_HOME (data repo), AIMS_GIT_NAME, AIMS_GIT_EMAIL, AIMS_ARTIFACTS (shared store)
USAGE
    ;;
  *) echo "aims: unknown command '$cmd' (try 'aims help')" >&2; exit 2 ;;
esac
