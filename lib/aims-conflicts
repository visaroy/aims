#!/usr/bin/env bash
set -euo pipefail
[ "${1:-}" = --scope ] && [ -n "${2:-}" ] && [ "$#" -eq 2 ] || { echo "usage: aims conflicts --scope <csv>" >&2; exit 2; }
repo="${AIMS_HOME:-$HOME/.aims}"; requested="$2"; git -C "$repo" fetch -q origin '+refs/heads/ai/*:refs/remotes/origin/ai/*' --prune 2>/dev/null || true
matches=0
while read -r branch; do
  sid="${branch#ai/}"; meta="$(git -C "$repo" show "origin/$branch:sessions/work/$sid/metadata.json" 2>/dev/null || echo '{}')"
  result="$(META="$meta" python3 - "$requested" "$sid" <<'PY'
import json,os,sys
requested=set(filter(None,sys.argv[1].split(','))); sid=sys.argv[2]
try: active=set(json.loads(os.environ['META']).get('scope',[]))
except Exception: active=set()
def overlaps(a,b):
    if a==b: return True
    ta,va=a.split(':',1); tb,vb=b.split(':',1)
    if ta!=tb: return False
    if ta=='path': return va.startswith(vb.rstrip('/')+'/') or vb.startswith(va.rstrip('/')+'/')
    return ta in {'repo','file','host','service'} and va==vb
for a in sorted(requested):
    for b in sorted(active):
        if overlaps(a,b): print(f'CONFLICT: {sid} requested={a} active={b}')
PY
)"
  [ -z "$result" ] || { printf '%s\n' "$result"; matches=1; }
done < <(git -C "$repo" ls-remote --heads origin 'refs/heads/ai/*' 2>/dev/null | sed 's#.*refs/heads/##' | sort)
[ "$matches" = 0 ] && echo 'SAFE: no overlapping writable resource.'
