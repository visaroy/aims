#!/usr/bin/env bash
set -euo pipefail
script_dir="$(cd "$(dirname "$0")" && pwd)"
. "$script_dir/aims-sentinel"
# Run inside a session worktree, or from AIMS_HOME/.worktrees as `aims handoff <session-id>`.
# Guarantees origin has the COMPLETE session work and marks it as handed off; it never merges to main.
if [ "${1:-}" = check ]; then
  shift; root="${AIMS_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"; exec "$root/lib/aims-handoff-check" "$@"
fi
branch="$(git branch --show-current)"
if [[ "$branch" != ai/* && "${1:-}" =~ ^[A-Za-z0-9._-]+$ ]]; then
  requested="$1"; repo="${AIMS_HOME:-$HOME/.aims}"; target="$repo/.worktrees/$requested"
  [ -d "$target" ] || { echo "ERROR: no local AIMS worktree for session $requested" >&2; exit 2; }
  [ "$(git -C "$target" branch --show-current)" = "ai/$requested" ] || { echo "ERROR: worktree branch does not match session $requested" >&2; exit 2; }
  [ -f "$target/sessions/work/$requested/metadata.json" ] || { echo "ERROR: missing session metadata for $requested" >&2; exit 2; }
  shift; cd "$target"; exec "$0" "$@"
fi
[[ "$branch" == ai/* ]] || { echo "ERROR: aims handoff must run inside an ai/<session-id> worktree or from AIMS_HOME/.worktrees with a session id" >&2; exit 2; }
sid="${branch#ai/}"
[[ "$sid" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "ERROR: unsafe session id: $sid" >&2; exit 2; }
git remote get-url origin >/dev/null 2>&1 || { echo "ERROR: handoff needs an 'origin' remote — it pushes the session so another machine can adopt it. Add one:" >&2; echo "  git remote add origin <url> && git push -u origin main" >&2; exit 1; }
note="${1:-}"                                                                    # optional handoff note (e.g. "waiting on OAuth client id")
meta="sessions/work/$sid/metadata.json"
[ -f "$meta" ] || { echo "ERROR: missing $meta — is this a session worktree?" >&2; exit 2; }
handoff_base_commit="$(git rev-parse HEAD)"
remote_ref="refs/remotes/origin/$branch"
had_remote=0
git rev-parse --verify --quiet "$remote_ref" >/dev/null && had_remote=1 || true
published_oid="$(aims_sentinel_oid "$sid" 2>/dev/null || true)"
git fetch --prune origin
observed_oid=""
git rev-parse --verify --quiet "$remote_ref" >/dev/null && observed_oid="$(git rev-parse "$remote_ref")" || true
if [ -n "$observed_oid" ]; then
  aims_assert_observed_ancestor "$branch" "$observed_oid" "$(git rev-parse HEAD)"
  aims_sentinel_mark "$sid" "$observed_oid"
else
  if [ "$had_remote" = 1 ] || [ -n "$published_oid" ]; then
    echo "REFUSE: origin/$branch disappeared after prior publication; not recreating it during handoff." >&2
    exit 1
  fi
  aims_assert_remote_absent "$(git remote get-url origin)" "$branch"
fi
python3 - "$meta" "$handoff_base_commit" <<PY                                                           # status=handoff + timestamp in metadata
import json,sys,datetime
p=sys.argv[1]; m=json.load(open(p))
m['status']='handoff'
m['handoff_at']=datetime.datetime.utcnow().strftime('%Y-%m-%dT%H:%M:%SZ')
m['handoff_from']=__import__('socket').gethostname().split('.')[0]
m['handoff_base_commit']=sys.argv[2]
json.dump(m,open(p,'w'),indent=2,ensure_ascii=False); open(p,'a').write('\n')
PY
wl="sessions/work/$sid/worklog.md"
{ printf '\n- HANDOFF %s from %s — origin has the COMPLETE work, ready for `aims adopt %s` elsewhere.' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(hostname -s)" "$sid"
  [ -n "$note" ] && printf ' Note: %s' "$note"; printf '\n'; } >> "$wl"
git add -A                                                                       # the WHOLE session worktree, not only sessions/ — closes the "save pushes only session files" gap
if git diff --cached --quiet; then echo "INFO: no uncommitted changes; pushing the handoff status only"; fi
git -c user.name="${AIMS_GIT_NAME:-AIMS Agent}" -c user.email="${AIMS_GIT_EMAIL:-aims@localhost}" commit -q -m "🤝 session: handoff $sid from $(hostname -s)" || { echo "ERROR: handoff checkpoint commit failed; worktree retained." >&2; exit 1; }
if [ -n "$observed_oid" ]; then
  git push -q --force-with-lease="refs/heads/$branch:$observed_oid" -u origin "$branch"
else
  git push -q --force-with-lease="refs/heads/$branch:$(aims_zero_oid)" -u origin "$branch"
fi
aims_sentinel_mark "$sid" "$(git rev-parse HEAD)"
echo "======================================================================"
echo "OK: HANDOFF $sid — origin synced (COMPLETE session work)."
echo "   On the target machine/agent:  aims adopt $sid"
echo "   (the live-writer warning will be SUPPRESSED — status=handoff = safe to take over)"
echo "======================================================================"
