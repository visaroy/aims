#!/usr/bin/env bash
set -euo pipefail
project="${1:-}"; topic="${2:-}"; shift 2 || true
[ -n "$project" ] && [ -n "$topic" ] || { echo "usage: aims start <project> <topic> [agent] --scope host:x,repo:y,... [--continues-from session-id] [--parent-session session-id]" >&2; exit 2; }
agent="opencode"; scope_csv=""; continues_from=""; parent_session=""
if [ $# -gt 0 ] && [ "${1#--}" = "$1" ]; then agent="$1"; shift; fi
while [ $# -gt 0 ]; do
  case "$1" in
    --scope) scope_csv="${2:-}"; [ -n "$scope_csv" ] || { echo "usage: aims start <project> <topic> [agent] --scope <csv>" >&2; exit 2; }; shift 2;;
    --continues-from) continues_from="${2:-}"; [ -n "$continues_from" ] || { echo "usage: aims start <project> <topic> [agent] --continues-from <session-id>" >&2; exit 2; }; shift 2;;
    --parent-session) parent_session="${2:-}"; [ -n "$parent_session" ] || { echo "usage: aims start <project> <topic> [agent] --parent-session <session-id>" >&2; exit 2; }; shift 2;;
    *) echo "ERROR: unknown aims-start option: $1" >&2; exit 2;;
  esac
done
[ -z "$continues_from" ] || [[ "$continues_from" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "ERROR: unsafe predecessor session id: $continues_from" >&2; exit 2; }
[ -z "$parent_session" ] || [[ "$parent_session" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "ERROR: unsafe parent session id: $parent_session" >&2; exit 2; }
repo="${AIMS_HOME:-$HOME/.aims}"
git -C "$repo" remote get-url origin >/dev/null 2>&1 || { echo "ERROR: data repo $repo has no 'origin' remote. AIMS syncs sessions through origin; add one first:" >&2; echo "  git -C \"$repo\" remote add origin <url> && git -C \"$repo\" push -u origin main" >&2; exit 1; }
if [ -n "${AIMS_ROOT:-}" ]; then AIMS_LIB="$AIMS_ROOT/lib"; else AIMS_LIB="$(cd "$(dirname "$0")" && pwd)"; fi   # engine = directory of this script
. "$AIMS_LIB/aims-sentinel"
. "$AIMS_LIB/aims-scope-locks"
. "$AIMS_LIB/aims-start-lock"
. "$AIMS_LIB/aims-lifecycle-guard"
aims_refuse_delegate
git -C "$repo" config user.name  >/dev/null 2>&1 || export GIT_AUTHOR_NAME="${AIMS_GIT_NAME:-AIMS Agent}"    GIT_COMMITTER_NAME="${AIMS_GIT_NAME:-AIMS Agent}"      # target repo may have no git identity (commit runs in its worktree)
git -C "$repo" config user.email >/dev/null 2>&1 || export GIT_AUTHOR_EMAIL="${AIMS_GIT_EMAIL:-aims@localhost}" GIT_COMMITTER_EMAIL="${AIMS_GIT_EMAIL:-aims@localhost}"  # fall back only when unset (real identity is kept)
sanitize() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'; }
sid="$(date -u +%Y%m%dT%H%M%SZ)-$(sanitize "$project")-$(sanitize "$topic")-$(sanitize "$agent")"
branch="ai/$sid"
wt="$repo/.worktrees/$sid"
scope_csv="$(aims_scope_csv "$scope_csv")" || exit 2
scope_json="$(aims_scope_json "$scope_csv")"
git -C "$repo" fetch origin main
conflicts="$("$AIMS_LIB/aims-conflicts" --scope "$scope_csv")" || exit 1
printf '%s\n' "$conflicts" | grep -q '^SAFE:' || { printf '%s\n' "$conflicts" >&2; echo 'ERROR: overlapping active session prevents start.' >&2; exit 1; }
[ -z "$parent_session" ] || {
  git -C "$repo" fetch -q origin "refs/heads/ai/$parent_session:refs/remotes/origin/ai/$parent_session" || { echo "ERROR: parent session is not active: $parent_session" >&2; exit 1; }
  parent_meta="$(git -C "$repo" show "origin/ai/$parent_session:sessions/work/$parent_session/metadata.json" 2>/dev/null)" || { echo "ERROR: parent session metadata is unavailable: $parent_session" >&2; exit 1; }
  parent_status="$(printf '%s' "$parent_meta" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("status", ""))')" || { echo "ERROR: parent session metadata is invalid: $parent_session" >&2; exit 1; }
  [ "$parent_status" = active ] || { echo "ERROR: parent session is not active: $parent_session (status=$parent_status)" >&2; exit 1; }
}
lock_oid="$(aims_start_lock_acquire "$repo" "$sid")" || { echo 'ERROR: another session admission is in progress; retry after it completes.' >&2; exit 1; }
lock_held=1
trap '[ "$lock_held" = 1 ] && aims_start_lock_release "$repo" "$lock_oid" 2>/dev/null || true' EXIT
if ! conflicts="$("$AIMS_LIB/aims-conflicts" --scope "$scope_csv")" || ! printf '%s\n' "$conflicts" | grep -q '^SAFE:'; then
  aims_start_lock_release "$repo" "$lock_oid" || true
  printf '%s\n' "${conflicts:-ERROR: cannot recheck active sessions.}" >&2
  echo 'ERROR: overlapping or unverifiable active session prevents start.' >&2
  exit 1
fi
aims_assert_remote_absent "$(git -C "$repo" remote get-url origin)" "$branch"
git -C "$repo" worktree add "$wt" -b "$branch" origin/main
mkdir -p "$wt/sessions/work/$sid"
cat > "$wt/sessions/work/$sid/metadata.json" <<JSON
{
  "session_id": "$sid",
  "project": "$project",
  "topic": "$topic",
  "agent": "$agent",
  "branch": "$branch",
  "worktree": "$wt",
  "status": "active",
  "started_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "scope": $scope_json,
  "environment": {
    "code_repos": [],
    "toolchain": [],
    "exec_host": "",
    "setup": "",
    "test": ""
  }$( [ -n "$continues_from" ] && printf ',\n  "continues_from": "%s"' "$continues_from" )$( [ -n "$parent_session" ] && printf ',\n  "parent_session": "%s"' "$parent_session" )
}
JSON
touch "$wt/sessions/work/$sid/worklog.md" "$wt/sessions/work/$sid/commands.md" "$wt/sessions/work/$sid/tests.md" "$wt/sessions/work/$sid/final-summary.md" "$wt/sessions/work/$sid/prompt-log.md"
git -C "$wt" add "sessions/work/$sid"
git -C "$wt" commit -m "🔒 session: start $sid"
if ! git -C "$wt" push --atomic --force-with-lease="refs/heads/$branch:$(aims_zero_oid "$wt")" --force-with-lease="$aims_start_lock_ref:$lock_oid" origin "$branch:refs/heads/$branch" ":$aims_start_lock_ref"; then
  git -C "$repo" worktree remove "$wt" --force 2>/dev/null || true
  git -C "$repo" branch -D "$branch" 2>/dev/null || true
  aims_start_lock_release "$repo" "$lock_oid" 2>/dev/null || true
  echo 'ERROR: admission commit failed; another writer may have started first.' >&2
  exit 1
fi
git -C "$wt" branch --set-upstream-to="origin/$branch" "$branch"
lock_held=0
trap - EXIT
aims_sentinel_mark_at "$wt" "$sid" "$(git -C "$wt" rev-parse HEAD)"
"$AIMS_LIB/aims-list" 2>/dev/null | grep -v "^$sid" | grep -q "STALE\|SCOPE" && echo "INFO: check active sessions above for scope overlap (aims-list)" >&2 || true
printf 'SESSION_ID=%s\nBRANCH=%s\nWORKTREE=%s\nSCOPE=%s\n' "$sid" "$branch" "$wt" "$scope_json"
