#!/usr/bin/env bash
set -euo pipefail
# Deprecated in 3.1 (kept for the 3.x contract): create or reuse a data repo only. Use `aims install`.
. "$(dirname "${BASH_SOURCE[0]}")/aims-home"  # single data repo resolver
[ "$#" -le 1 ] || { echo "usage: aims init [dir]" >&2; exit 2; }
echo "NOTE: 'aims init' is deprecated since 3.1.0; 'aims install' sets up the data repo, guard, and agent rules." >&2
home="${1:-$(aims_home)}"
"$(dirname "${BASH_SOURCE[0]}")/aims-scaffold-data" "$home"
[ "$home" = "$(aims_home)" ] || echo "   Not the resolved data repo; to use it run: AIMS_HOME=$home aims install" >&2
echo "   Add a remote so sessions sync:  git -C $home remote add origin <url>" >&2
